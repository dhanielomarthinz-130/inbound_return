Options -MultiViews
RewriteEngine On

# 1. Redirect eksternal dari *.php ke Clean URL (hanya untuk request GET non-API)
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s+([^?\s]+)\.php(\?[^\s]*)?\s [NC]
RewriteCond %{THE_REQUEST} !/api/ [NC]
RewriteRule ^ %1%2 [R=301,L]

# 1b. Normalisasi akses relatif ke folder uploads/ dan assets/ dari Clean URL (misal: /admin/uploads/... -> /uploads/...)
RewriteRule ^(?:admin|menu|scanner|reception|penerimaan|dossier|claim_dossier|claim_invoice|claim-invoice)/uploads/(.+)$ uploads/$1 [L,NC]
RewriteRule ^(?:admin|menu|scanner|reception|penerimaan|dossier|claim_dossier|claim_invoice|claim-invoice)/assets/(.+)$ assets/$1 [L,NC]
RewriteRule ^.*/uploads/(.+)$ uploads/$1 [L,NC]
RewriteRule ^.*/assets/(.+)$ assets/$1 [L,NC]

# 2. Izinkan akses langsung ke file aset statis (CSS, JS, gambar, video, fonts) dan direktori
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>
</IfModule>
RewriteCond %{REQUEST_FILENAME} -d [OR]
RewriteCond %{REQUEST_URI} \.(css|js|png|jpg|jpeg|gif|svg|webp|ico|webm|mp4|woff|woff2|ttf|eot)$ [NC]
RewriteRule ^ - [L]

# 4. API Rewrites
RewriteRule ^api/invoice/(.+)$ api/invoice.php?invoice_number=$1 [QSA,L]
RewriteRule ^api/product/(.+)$ api/product.php?barcode=$1 [QSA,L]
RewriteRule ^api/returns/?$ api/returns.php [QSA,L]
RewriteRule ^api/admin/metrics/?$ api/admin/metrics.php [QSA,L]
RewriteRule ^api/admin/transactions/?$ api/admin/transactions.php [QSA,L]
RewriteRule ^api/admin/session/([^/]+)/items/?$ api/admin/session_items.php?session_id=$1 [QSA,L]
RewriteRule ^api/products/?$ api/products.php [QSA,L]
RewriteRule ^api/expeditions/?$ api/expeditions.php [QSA,L]
RewriteRule ^api/reception/?$ api/reception.php [QSA,L]

# 5. Route Clean URLs ke PHP scripts
RewriteRule ^menu/?$ menu.php [QSA,L]
RewriteRule ^admin/?$ admin.php [QSA,L]
RewriteRule ^scanner/?$ index.php [QSA,L]
RewriteRule ^reception/?$ reception.php [QSA,L]
RewriteRule ^penerimaan/?$ reception.php [QSA,L]
RewriteRule ^login/?$ login.php [QSA,L]
RewriteRule ^logout/?$ logout.php [QSA,L]
RewriteRule ^claim_dossier/?$ claim_dossier.php [QSA,L]
RewriteRule ^dossier/?$ claim_dossier.php [QSA,L]
RewriteRule ^claim_invoice/?$ claim_invoice.php [QSA,L]
RewriteRule ^claim-invoice/?$ claim_invoice.php [QSA,L]
RewriteRule ^invoice_klaim/?$ claim_invoice.php [QSA,L]

# 6. Fallback jika ada file PHP lain yang diakses tanpa ekstensi
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [QSA,L]
